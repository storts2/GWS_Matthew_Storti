@page
@model GMS_Matthew_Storti.Pages.PriceModel

<div class="d-flex flex-column gap-4 bg-primary text-white p-4 rounded-4 shadow justify-content-center align-items-center gap-3">
    <h1>Search By Price</h1>
    <div class="d-flex flex-row justify-content-center align-items-center gap-4">
        <form method="post" asp-page-handler="Price" class="d-flex flex-column gap-1">    
            <div class="d-flex flex-column">
                <input asp-for="CurrentPrice" placeholder="Enter Price Here" class="p-1 rounded-2 border-0"/>
            </div>
            <button type="submit" class="bg-success border-0 mt-2 text-white p-1 rounded-2">Set Price</button>
        </form>
        @if (Model.Items != null && Model.Items.Count > 0) {
            <table class="table table-secondary table-hover align-middle m-0 p-2 rounded-3 overflow-hidden">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Price</th>
                        <th>Category</th>
                        <th>Date</th>
                        <th>Quantity</th>
                        <th>Price</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td>@i.Name</td>
                            <td>@i.Price</td>
                            <td>@i.Category</td>
                            <td>@i.Date</td>
                            <td>@i.Quantity</td>
                            <td>@i.Price</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>There are no items greater than the price...</p>
        }
    </div>
</div>