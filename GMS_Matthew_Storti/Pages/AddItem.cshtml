@page
@model GMS_Matthew_Storti.Pages.AddItemModel

<h1>Add A Grocery Items</h1>

<form method="post">
    <div>
        <label asp-for="Item.Name">Name</label>
        <input asp-for="Item.Name"/>
    </div>
    <div>
        <label asp-for="Item.Category">Category</label>
        <input asp-for="Item.Category" />
    </div>
    <div>
        <label asp-for="Item.Date">Date</label>
        <input asp-for="Item.Date" />
    </div>
    <div>
        <label asp-for="Item.Quantity">Quantity</label>
        <input asp-for="Item.Quantity" />
    </div>
    <div>
        <label asp-for="Item.Price">Price</label>
        <input asp-for="Item.Price" />
    </div>
    <button type="submit">Add Item</button>
</form>

<p>@Model.Message</p>

